{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:mock": "cross-env MSW_ENABLE=true next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome check --write",
    "update:xiilab-ui": "pnpm update xiilab-ui",
    "test": "pnpm test:allure:history && bddgen && playwright test",
    "test:build": "pnpm build && pnpm test",
    "test:ui": "pnpm test:allure:history && bddgen && playwright test --ui",
    "test:headed": "pnpm test:allure:history && bddgen && playwright test --headed",
    "test:debug": "pnpm test:allure:history && bddgen && playwright test --debug",
    "test:smoke": "pnpm test:allure:history && bddgen && playwright test --grep @smoke",
    "test:regression": "pnpm test:allure:history && bddgen && playwright test --grep @regression",
    "test:grep": "pnpm test:allure:history && bddgen && playwright test --grep",
    "test:report": "playwright show-report tests/reports/playwright-html",
    "test:allure": "allure generate allure-results -o allure-report --clean && allure open allure-report",
    "test:allure:generate": "allure generate allure-results -o allure-report --clean",
    "test:allure:open": "allure open allure-report",
    "test:allure:history": "node scripts/copy-allure-history.mjs",
    "test:trace": "playwright show-trace",
    "test:codegen": "playwright codegen http://localhost:3000",
    "bddgen": "npx playwright-bdd test",
    "bddgen:export": "npx playwright-bdd export",
    "prepare": "husky"
  },
  "dependencies": {
    "@anatine/zod-mock": "^3.14.0",
    "@ant-design/nextjs-registry": "^1.2.0",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@faker-js/faker": "^9.0.0",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.8.4",
    "@tanstack/react-query-devtools": "^5.8.4",
    "@uiw/react-codemirror": "^4.25.2",
    "@xiilab/astrago-openapi": "0.0.2-dev",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "ansi-colors": "^4.1.3",
    "antd": "^5.12.2",
    "apexcharts": "^5.3.0",
    "axios": "^1.13.1",
    "classnames": "^2.5.1",
    "date-fns": "^4.1.0",
    "es-toolkit": "^1.42.0",
    "jotai": "^2.12.5",
    "lodash": "^4.17.21",
    "next": "16.0.7",
    "next-auth": "^4.24.11",
    "react": "19.2.0",
    "react-apexcharts": "^1.7.0",
    "react-custom-scrollbars": "^4.2.1",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.68.0",
    "react-markdown": "^9.0.1",
    "react-syntax-highlighter": "^15.5.0",
    "react-toastify": "^11.0.5",
    "remark-gfm": "^4.0.0",
    "split.js": "^1.6.5",
    "styled-components": "^6.1.19",
    "uuid": "^11.1.0",
    "xiilab-ui": "git+https://github.com/xiilab/xiilab-ui.git",
    "xterm-theme": "^1.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@playwright/test": "^1.56.1",
    "@types/lodash": "^4.17.20",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-custom-scrollbars": "^4.0.13",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "allure-commandline": "^2.36.0",
    "allure-playwright": "^3.4.3",
    "autoprefixer": "^10.4.21",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "msw": "^2.11.6",
    "playwright-bdd": "^8.4.1",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json}": [
      "biome check --write"
    ]
  },
  "packageManager": "pnpm@9.15.3"
}

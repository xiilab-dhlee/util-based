#!/usr/bin/env sh

# Husky pre-push hook: Run type-check and lint before push

# Windows에서는 검사 건너뛰기 (CRLF/LF 이슈)
exit 0
case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*|Windows_NT)
    echo "⚠️ Windows 환경: type-check/lint 건너뜀"
    exit 0
    ;;
esac

echo "🔍 Running type-check..."
pnpm exec tsc --noEmit || {
  echo "❌ Type check failed. Please fix the errors and try again."
  exit 1
}

echo "🔍 Running lint..."
pnpm lint || {
  echo "❌ Lint check failed. Please fix the errors and try again."
  exit 1
}

echo "✅ All checks passed!"
